# Terraform working data and state can contain sensitive values.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local plans, variable values, and override files.
*.tfplan
terraform.tfvars
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep the dependency lock file in version control.
!.terraform.lock.hcl

# Local SSH private key if one is accidentally created in this folder.
*.pem
